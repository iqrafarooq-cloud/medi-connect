# Copy to apps/web/.env and fill in values
# App queries can use the pooler; migrations need session/direct mode.
DATABASE_URL=postgresql://user:pass@localhost:5432/medi_connect
DIRECT_URL=postgresql://user:pass@localhost:5432/medi_connect
BETTER_AUTH_SECRET=replace-with-at-least-32-character-secret
BETTER_AUTH_URL=http://localhost:3001

# Supabase storage + Postgres (enable pgvector in the SQL editor first)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback (optional): SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CLINIC_BUCKET=clinic-documents
SUPABASE_PATIENT_BUCKET=patients

# Google Maps — clinic registration location picker
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key

# Google Vertex AI — chat (Gemini) + embeddings
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
# Must match the project_id inside your service-account JSON.
# Enable Vertex AI API on THAT project:
# https://console.developers.google.com/apis/api/aiplatform.googleapis.com/overview?project=YOUR_PROJECT_ID
GOOGLE_VERTEX_CHAT_MODEL=gemini-2.5-flash
GOOGLE_VERTEX_EMBEDDING_MODEL=gemini-embedding-2
# Prefer one of:
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# or inline service account:
# GOOGLE_CLIENT_EMAIL=you@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
